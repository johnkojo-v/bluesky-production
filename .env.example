APP_NAME="Bluesky Production Engine"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=bluesky_prod
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_PATH=/tmp/bluesky-production.sqlite

BLUESKY_ENABLED=true
BLUESKY_PDS_URL=https://bsky.social
BLUESKY_API_URL=https://bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_HANDLE=

JWT_SECRET=replace-with-a-secure-secret
SESSION_LIFETIME=3600

QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
